  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "businessId", "value": "" },
    { "key": "shopId", "value": "" },
    { "key": "accountId", "value": "" },
    { "key": "productId", "value": "" },
