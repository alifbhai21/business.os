# Server environment configuration
NODE_ENV=development
PORT=4000

# MongoDB connection string (if omitted, an in-memory MongoDB is used for dev)
# DATABASE_URL=mongodb://127.0.0.1:27017/business-os
# DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/business-os

# JWT secrets (min 16 chars; change in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me-123456
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-123456

# Token lifetimes (msd notation: s/m/h/d)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Account lockout policy
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# CORS origin (comma-separated list, or * for all)
CORS_ORIGIN=*
