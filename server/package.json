{
  "name": "business-os-server",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Business System - backend API (Express + MongoDB)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "tsx --test test/**/*.test.ts",
    "test:perf": "tsx --test test/performance/core-reads.check.ts test/performance/catalog-search-5k.check.ts",
    "test:atlas": "cross-env RATE_LIMIT_MAX=100000 tsx --test test/atlas/integration.atlas.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "mongodb-memory-server": "^9.4.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0"
  }
}
